# Copy to .env and fill in. .env is gitignored; never commit it.

# Bearer token the watch sends with every upload. `python launch.py token` creates it for you.
INGEST_TOKEN=

# Hugging Face read token, for speaker labels (free). Accept the model terms first:
#   https://huggingface.co/pyannote/speaker-diarization-community-1
# Without it everything still works, but every line is labeled as one speaker.
# Easiest: paste it in the dashboard under Settings > Voices > Speaker labels, which writes this line.
HF_TOKEN=

# --- Network ---------------------------------------------------------------
# Wi-Fi mode (default in SETUP.md): the watch uploads to this PC on your home network.
BIND_HOST=0.0.0.0
PORT=8808
# Set to 1 to open the dashboard from other devices on your home network (no login in front of it).
DASHBOARD_ON_LAN=

# Tunnel mode (optional, upload from anywhere): set BIND_HOST=127.0.0.1 and the hostname the watch
# uploads to. Requests on that hostname can only reach the watch API.
INGEST_HOST=
# Cloudflare Access service token, if the upload hostname sits behind Access.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# --- Optional --------------------------------------------------------------
# Private iCal link of your calendar, for "record my meetings" in auto mode.
# The dashboard writes this for you (Settings > Auto mode > When to listen).
CALENDAR_ICS_URL=
# API key for the "API key or local model" summary provider. The dashboard writes this for you.
SUMMARY_API_KEY=
